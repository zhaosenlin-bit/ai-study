class TestPath(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.data = SubjectMathData()
        cls.kp_by_id = {k["id"]: k for k in cls.data.knowledge_points}

    def test_prerequisites_chain(self):
        """三位数乘两位数的完整前置链（跨年级）。"""
        chain = collect_prerequisites("math_g4_three_digit_times_two_digit", self.kp_by_id)
        self.assertIn("math_g3_multi_digit_times_one_digit", chain)
        self.assertIn("math_g3_multiples", chain)
        self.assertIn("math_g3_addition_within_10000", chain)

    def test_recommend_path_orders_prerequisites_first(self):
        """薄弱知识点推荐：前置知识任务排在自身之前。"""
        mastery = {
            "math_g4_three_digit_times_two_digit": 0.2,
            "math_g3_word_problem_modeling": 0.9,
        }
        tasks = recommend_path(mastery, self.kp_by_id, limit=10)
        kp_ids = [t["knowledge_point_id"] for t in tasks]
