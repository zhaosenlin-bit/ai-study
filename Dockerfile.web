# ============================================================
# Dockerfile · ai-study 前端(React + Vite + Nginx)
# 多阶段:node:20-alpine build → nginx:alpine serve
# 路径:ai-study/Dockerfile.web(部署到 ai-study 仓库根)
# 创建:2026-09-04 小C
# ============================================================

# ---- 阶段 1 · 构建 ----
FROM node:20-alpine AS builder
WORKDIR /app

# 锁文件优先
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# 业务代码
COPY apps/web/ ./
COPY packages/ ../packages/ 2>/dev/null || true

# 构建(用后端 API 地址,build 时 VITE_API_BASE_URL 注入)
# 生产环境:VITE_API_BASE_URL 留空,走同源 /api
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_USE_MOCK=false
ENV VITE_USE_MOCK=$VITE_USE_MOCK

RUN npm run build

# ---- 阶段 2 · Nginx 托管 ----
FROM nginx:alpine AS runner

# 反代配置(把 /api 转发到后端服务 ai-study-api:8000)
COPY nginx/ai-study.conf /etc/nginx/conf.d/default.conf

# 静态产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
