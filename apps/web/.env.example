# ai-study 前端环境变量（复制为 .env 后按需修改）
# 联调阶段后端网关地址（角色 A 的 FastAPI）
VITE_API_BASE_URL=http://localhost:8000
# true=使用内置 mock 数据（默认），false=请求真实 API
VITE_USE_MOCK=true
# MiniMax 情绪观察：AI 分析学生心情并驱动伙伴表情（Key 只填在 .env.local，勿提交）
# 从 https://platform.minimaxi.com 控制台生成，形如 sk-cp-xxxx
VITE_MINIMAX_API_KEY=
# 备用 Key：主 Key Token 额度用尽（status 2056）时自动切换
VITE_MINIMAX_API_KEY_BACKUP=
